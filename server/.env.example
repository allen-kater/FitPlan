# ===================================
# FitPlan 生产环境变量（Railway 部署用）
# 在 Railway 项目 Settings → Variables 中设置
# ===================================

# PostgreSQL 连接串（Railway PostgreSQL 插件会自动注入 DATABASE_URL，无需手动填写）
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT 密钥（务必修改为强随机字符串！）
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# 服务端口（Railway 自动注入 PORT，无需手动设置）
PORT=3001

# CORS 允许的前端域名（同域部署留空或设为同源）
CORS_ORIGIN=https://your-app-name.up.railway.app

# Node 环境
NODE_ENV=production
